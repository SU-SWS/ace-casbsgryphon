{
    "name": "su-sws/ace-casbsgryphon",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://userguide.sites.stanford.edu/"
    },
    "require": {
        "php": ">=8.3",
        "acquia/blt": "^13.7",
        "cweagans/composer-patches": "^1.6",
        "drupal/acquia_connector": "^3.0",
        "drupal/acquia_purge": "^1.3",
        "drupal/autoservices": "^1.0",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-recommended": "^10.0",
        "drupal/devel": "^5.1",
        "drupal/devel_php": "^1.5",
        "drupal/mysql56": "^1.1",
        "drush/drush": "^12",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "acquia/blt-drupal-test": "^1.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "su-sws/blt-sws": "dev-main",
        "su-sws/drupal-dev": "^10.0"
    },
    "replace": {
        "drupal/coder": "*"
    },
    "conflict": {
        "drupal/drupal": "*",
        "seboettg/collection": ">=4.0.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "citation-style-language/locales",
                "version": "1.0.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/citation-style-language/locales.git",
                    "reference": "master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "citation-style-language/styles-distribution",
                "version": "1.0.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/citation-style-language/styles-distribution.git",
                    "reference": "master"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "discard-changes": true,
        "allow-plugins": true
    },
    "extra": {
        "merge-plugin": {
            "require": [
                "docroot/profiles/custom/stanford_profile/composer.json"
            ],
            "merge-extra": true
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "docroot/"
            },
            "gitignore": false
        },
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "custom-installer": {
            "docroot/libraries/{$name}/": [
                "type:component",
                "ckeditor/ckeditor",
                "enyo/dropzone",
                "components/jquery",
                "harvesthq/chosen"
            ],
            "vendor/{$vendor}/{$name}/": [
                "type:library"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/google_analytics": {
                "https://www.drupal.org/project/google_analytics/issues/3373921": "https://www.drupal.org/files/issues/2023-08-07/google-analytics-issues-3373921-cannot-install-from-existing-config-11.patch"
            },
            "drupal/hook_event_dispatcher": {
                "https://www.drupal.org/project/hook_event_dispatcher/issues/3354751": "https://www.drupal.org/files/issues/2024-03-14/hook_event_dispatcher-4.x-3354751-7.patch"
            },
            "drupal/menu_link": {
                "https://www.drupal.org/project/menu_link/issues/3358081": "https://git.drupalcode.org/project/menu_link/-/merge_requests/9.patch"
            },
            "drupal/menu_link_weight": {
                "https://www.drupal.org/project/menu_link_weight/issues/2875984": "https://git.drupalcode.org/project/menu_link_weight/-/merge_requests/2.diff"
            },
            "drupal/core": {
                "https://www.drupal.org/project/drupal/issues/3151977": "patches/media-recursion-limit.patch"
            },
            "drupal/paranoia": {
                "https://stanfordits.atlassian.net/browse/D8CORE-1351": "patches/contrib/paranoia.patch"
            },
            "drupal/ui_patterns": {
                "Ui Patterns Views Fixes": "patches/contrib/ui_patterns_views-preview.patch"
            },
            "drupal/taxonomy_entity_index": {
                "Fix PHP 8 strict error with arrays": "patches/contrib/taxonomy_entity_index.patch"
            },
            "drupal/google_tag": {
                "Comment out GA conflict in Google Tag": "patches/contrib/google_tag-ga_conflict.patch"
            },
            "seboettg/citeproc-php": {
                "D8CORE-6866 Non Numeric pages for citation generator": "patches/contrib/citeproc-pages.patch"
            }
        }
    },
    "scripts": {
        "post-drupal-scaffold-cmd": [
            "patch -Ns -r \"\" --no-backup-if-mismatch -p1 < ./patches/htaccess.patch",
            "patch -Ns -r \"\" --no-backup-if-mismatch -p1 < ./patches/robotstxt.patch"
        ],
        "init-stack": [
            "vendor/bin/blt blt:telemetry:disable --no-interaction",
            "vendor/bin/blt blt:init:settings",
            "vendor/bin/blt sws:keys",
            "vendor/bin/blt drupal:install -n"
        ],
        "local-install": [
            "composer update --no-interaction",
            "cp lando/example.local.blt.yml blt/local.blt.yml",
            "blt blt:init:settings"
        ],
        "sync-casbs": [
            "drush -y sql:sync @default.prod @default.local",
            "drush -y rsync @default.prod:%files @default.local:%files"
        ],
        "sync-db": [
            "drush -y sql:sync @default.dev @default.local"
        ]
    }
}
