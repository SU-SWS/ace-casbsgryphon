{
    "name": "su-sws/ace-casbsgryphon",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://userguide.sites.stanford.edu/"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "citation-style-language/locales",
                "version": "1.0.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/citation-style-language/locales.git",
                    "reference": "master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "citation-style-language/styles-distribution",
                "version": "1.0.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/citation-style-language/styles-distribution.git",
                    "reference": "master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "noli42/chosen",
                "version": "3.0.0",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "chosen"
                },
                "dist": {
                    "url": "https://github.com/noli42/chosen/releases/download/3.0.0/chosen-assets-v3.0.0.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "cure53/dompurify",
                "version": "3.3.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/cure53/DOMPurify.git",
                    "type": "git",
                    "reference": "3.3.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.6",
        "drupal/acquia_purge": "^1.1",
        "drupal/core-composer-scaffold": "^11.3.0",
        "drupal/core-recommended": "^11.3.0",
        "drush/drush": "^13",
        "su-sws/sws-drush-commands": "1.x-dev",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "su-sws/drupal-dev": "^11.0"
    },
    "replace": {
        "drupal/coder": "*"
    },
    "conflict": {
        "drupal/drupal": "*",
        "drupal/jsonapi_views": ">1.1.0",
        "drupal/readonly_field_widget": ">2.1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "discard-changes": true,
        "allow-plugins": true,
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    },
    "extra": {
        "merge-plugin": {
            "require": [
                "docroot/profiles/custom/stanford_profile/composer.json"
            ],
            "merge-extra": true,
            "merge-extra-deep": true
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "docroot/"
            },
            "gitignore": false
        },
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "custom-installer": {
            "docroot/libraries/{$name}/": [
                "type:component",
                "ckeditor/ckeditor",
                "enyo/dropzone",
                "components/jquery",
                "harvesthq/chosen"
            ],
            "vendor/{$vendor}/{$name}/": [
                "type:library"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ]
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/core": {
                "https://www.drupal.org/project/drupal/issues/3151977": "patches/media-recursion-limit.patch",
                "https://www.drupal.org/project/drupal/issues/3530911": "patches/core-render-button.patch"
            },
            "drupal/config_readonly": {
                "Handle ConfigTarget objects in #config_target form elements": "patches/contrib/config_readonly-config_target.patch"
            },
            "drupal/graphql_compose": {
                "Remove link language setting on field results": "patches/contrib/graphql_compose-link_language.patch"
            },
            "drupal/paranoia": {
                "https://stanfordits.atlassian.net/browse/D8CORE-1351": "patches/contrib/paranoia.patch"
            },
            "su-sws/paranoia": {
                "https://stanfordits.atlassian.net/browse/D8CORE-1351": "patches/contrib/paranoia.patch"
            },
            "drupal/ui_patterns": {
                "Ui Patterns Views Fixes": "patches/contrib/ui_patterns_views-preview.patch"
            },
            "drupal/taxonomy_entity_index": {
                "Fix PHP 8 strict error with arrays": "patches/contrib/taxonomy_entity_index.patch"
            },
            "drupal/google_tag": {
                "Comment out GA conflict in Google Tag": "patches/contrib/google_tag-ga_conflict.patch"
            },
            "seboettg/citeproc-php": {
                "D8CORE-6866 Non Numeric pages for citation generator": "patches/contrib/citeproc-pages.patch"
            }
        }
    },
    "scripts": {
        "post-drupal-scaffold-cmd": [
            "patch -Ns -r \"\" --no-backup-if-mismatch -p1 < ./patches/htaccess.patch",
            "patch -Ns -r \"\" --no-backup-if-mismatch -p1 < ./patches/robotstxt.patch"
        ],
        "init-stack": [
            "drush settings",
            "drush sws:keys",
            "drush drupal:install -n"
        ],
        "local-install": [
            "composer update --no-interaction",
            "drush settings"
        ],
        "sync-casbs": [
            "drush -y sql:sync @default.prod @default.local --structure-tables-list=search_*,cache_*,history,watchdog,sessions",
            "drush -y rsync @default.prod:%files @default.local:%files"
        ],
        "sync-db": [
            "drush -y sql:sync @default.prod @default.local"
        ],
        "pull-profile": [
            "rm -rf docroot/profiles/custom/stanford_profile",
            "git checkout docroot/profiles/custom/stanford_profile",
            "git remote add stanford_profile git@github.com:SU-SWS/stanford_profile.git || true",
            "git subtree pull --prefix=docroot/profiles/custom/stanford_profile --squash stanford_profile 12.x || true",
            "git checkout --ours docroot/profiles/custom/stanford_profile/composer.json",
            "git checkout --ours docroot/profiles/custom/stanford_profile/stanford_profile.info.yml",
            "git add docroot/profiles/custom/stanford_profile/composer.json docroot/profiles/custom/stanford_profile/stanford_profile.info.yml"
        ]
    },
    "autoload": {
        "psr-4": {
            "Drupal\\CasbsDrush\\": "drush/casbs/src"
        }
    }
}
